# Optional: copy this file to .env for local OpenAI career chat and job ranking.
# Local AI chat works without any API key on a Mac with the downloaded model.
# Keep .env on your computer; it is ignored by Git and never sent to the browser.
OPENAI_API_KEY=
# Optional for local use; the default is gpt-6-luna.
# The public Render site always uses gpt-6-luna when OPENAI_API_KEY is configured.
# OPENAI_MODEL=gpt-6-luna
